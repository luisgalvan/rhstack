#!/usr/bin/env bash
# rhstack-config: lee o escribe una clave de configuración de proyecto dentro de la
# convención "Diseño agnóstico de plataforma" de CLAUDE.md, p. ej. jurisdicción, moneda, formato de exportación de HRIS.
#
# Uso:
#   rhstack-config get <key>
#   rhstack-config set <key> <value>
set -euo pipefail

REPO_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
CLAUDE_MD="$REPO_DIR/CLAUDE.md"
SECTION="## Project config"

cmd="${1:-}"
key="${2:-}"
value="${3:-}"

ensure_section() {
  if ! grep -q "^$SECTION$" "$CLAUDE_MD" 2>/dev/null; then
    printf '\n%s\n\n' "$SECTION" >> "$CLAUDE_MD"
  fi
}

case "$cmd" in
  get)
    [ -n "$key" ] || { echo "uso: rhstack-config get <key>" >&2; exit 1; }
    grep -A 50 "^$SECTION$" "$CLAUDE_MD" 2>/dev/null | grep "^- $key:" | sed "s/^- $key: //" || true
    ;;
  set)
    [ -n "$key" ] && [ -n "$value" ] || { echo "uso: rhstack-config set <key> <value>" >&2; exit 1; }
    ensure_section
    if grep -q "^- $key:" "$CLAUDE_MD"; then
      sed -i "s|^- $key:.*|- $key: $value|" "$CLAUDE_MD"
    else
      awk -v section="$SECTION" -v line="- $key: $value" '
        {print}
        $0==section {print line}
      ' "$CLAUDE_MD" > "$CLAUDE_MD.tmp" && mv "$CLAUDE_MD.tmp" "$CLAUDE_MD"
    fi
    echo "ASIGNADO $key = $value"
    ;;
  *)
    echo "uso: rhstack-config <get|set> <key> [value]" >&2
    exit 1
    ;;
esac
